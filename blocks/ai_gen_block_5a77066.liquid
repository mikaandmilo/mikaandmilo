{% doc %}
  @prompt
    Shopify section that shows a smooth, infinite marquee loop
    
    Background color #B38B9D
    
    Separate speed controls for mobile and desktop, can it be infinite loop, for content I need text 1,2,3,4,5, need to go all the time, without end and free space, desktop speed 80, mobile speed 80, 150 speed on desktop and 150 on mobile

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-marquee-container-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
    overflow: hidden;                 /* seče sve van kontejnera */
    white-space: nowrap;
    position: relative;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  .ai-marquee-track-{{ ai_gen_id }} {
    display: inline-flex;
    animation: ai-marquee-scroll-{{ ai_gen_id }} var(--ai-marquee-duration-{{ ai_gen_id }}) linear infinite;
    will-change: transform;
    gap: {{ block.settings.item_spacing }}px;
  }

  .ai-marquee-item-{{ ai_gen_id }} {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    white-space: nowrap;
  }

  @keyframes ai-marquee-scroll-{{ ai_gen_id }} {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-100%); }
  }

  /* Desktop brzina */
  @media screen and (min-width: 750px) {
    .ai-marquee-container-{{ ai_gen_id }} {
      --ai-marquee-duration-{{ ai_gen_id }}: {{ block.settings.speed_desktop }}s;
    }
  }

  /* Mobile: fiksna širina 360px + centriranje */
  @media screen and (max-width: 749px) {
    .ai-marquee-container-{{ ai_gen_id }} {
      --ai-marquee-duration-{{ ai_gen_id }}: {{ block.settings.speed_mobile }}s;
      width: 360px;        /* fiksna širina na mobilu */
      max-width: 100%;     /* ne prelazi ekran ako je uži */
      margin: 0 auto;      /* centriranje */
      padding-left: 0;     /* po želji ukloni bočne paddinge */
      padding-right: 0;
      overflow: hidden;    /* sigurnosno */
    }

    .ai-marquee-track-{{ ai_gen_id }} {
      gap: clamp(12px, 4vw, {{ block.settings.item_spacing }}px);
    }
  }
{% endstyle %}

{% style %}
/* 1) Klipuj baš wrapper koji animira – dodaj viewport omotač ako ga nema */
.ai-marquee-viewport-{{ ai_gen_id }}{ overflow:hidden; width:100%; }

/* 2) Drži marquee u 360px “okviru” i centriraj */
@media (max-width: 749px){
  .ai-marquee-container-{{ ai_gen_id }}{
    width: 100%;
    max-width: 360px;      /* fiksni gornji limit */
    margin: 0 auto;
    overflow: hidden;
  }
  /* 3) Spreči da ancestor-i šire layout na mobilu */
  .ai-marquee-container-{{ ai_gen_id }}:where(*) {
    box-sizing: border-box;
  }
  /* 4) Ako neki parent koristi 100vw – prebij u 100% (samo za ovu sekciju) */
  .ai-marquee-container-{{ ai_gen_id }} .use-viewport,
  .ai-marquee-container-{{ ai_gen_id }} [style*="width:100vw"]{
    width: 100% !important;
  }
  /* 5) Osiguranje: nikakav unutrašnji padding neće probiti 360px “frame” */
  .ai-marquee-viewport-{{ ai_gen_id }}{
    padding-left: 0;
    padding-right: 0;
    max-width: 100%;
  }
}
/* 6) Apsolutni fallback ako nešto drugo na strani pravi skrol */
@media (max-width: 749px){
  html, body { overflow-x:hidden; }
}
{% endstyle %}




<marquee-component-{{ ai_gen_id }}
  class="ai-marquee-container-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-marquee-track-{{ ai_gen_id }}" id="ai-marquee-track-{{ ai_gen_id }}">
    {% for repeat in (1..10) %}
      {% if block.settings.text_1 != blank %}
        <div class="ai-marquee-item-{{ ai_gen_id }}">
          {{ block.settings.text_1 }}
        </div>
      {% endif %}{% if block.settings.text_2 != blank %}
        <div class="ai-marquee-item-{{ ai_gen_id }}">
          {{ block.settings.text_2 }}
        </div>
      {% endif %}
      {% if block.settings.text_3 != blank %}
        <div class="ai-marquee-item-{{ ai_gen_id }}">
          {{ block.settings.text_3 }}
        </div>
      {% endif %}
      {% if block.settings.text_4 != blank %}
        <div class="ai-marquee-item-{{ ai_gen_id }}">
          {{ block.settings.text_4 }}
        </div>
      {% endif %}
      {% if block.settings.text_5 != blank %}
        <div class="ai-marquee-item-{{ ai_gen_id }}">
          {{ block.settings.text_5 }}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</marquee-component-{{ ai_gen_id }}><script>
  (function() {
    class MarqueeComponent{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.track = this.querySelector('#ai-marquee-track-{{ ai_gen_id }}');
        this.setupInfiniteMarquee();
      }

      setupInfiniteMarquee() {
        if (!this.track) return;

        const trackContent = this.track.innerHTML;
        this.track.innerHTML = trackContent + trackContent;

        this.track.addEventListener('animationiteration', () => {
          this.track.style.transform = 'translateX(0)';
        });
      }
    }

    customElements.define('marquee-component-{{ ai_gen_id }}', MarqueeComponent{{ ai_gen_id }});
  })();
</script>

