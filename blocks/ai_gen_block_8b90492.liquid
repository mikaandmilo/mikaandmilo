{% doc %}
  @prompt
    9 images in one row and carousel on mobile, on mobile 2 images per row, and headline above them, for mobile make smaller images and 2 per slide, images on mobile 350px size, desktop image size based on image, mobile image width 250px, images size on mobile 150px

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-carousel-{{ ai_gen_id }} {
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};}

  .ai-image-carousel__heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin: 0 0 30px;color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-image-carousel__container-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-image-carousel__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(9, 1fr);
    gap: {{ block.settings.image_spacing }}px;
  }

  .ai-image-carousel__item-{{ ai_gen_id }} {
    position: relative;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
  }

  .ai-image-carousel__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;transition: transform 0.3s ease;
  }

  .ai-image-carousel__image-{{ ai_gen_id }}:hover {
    transform: scale(1.05);
  }

  .ai-image-carousel__placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-image-carousel__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-image-carousel__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 8px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 10px;
    color: #666;
    text-align: center;
    white-space: nowrap;
  }

  .ai-image-carousel__mobile-container-{{ ai_gen_id }} {
    display: none;
    position: relative;
  }

  .ai-image-carousel__mobile-track-{{ ai_gen_id }} {
    overflow: hidden;
    width: 100%;
  }

  .ai-image-carousel__mobile-slides-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.3s ease;
    width: 100%;
  }

  .ai-image-carousel__mobile-slide-{{ ai_gen_id }} {
    min-width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.image_spacing }}px;
    flex-shrink: 0;justify-items: center;
  }

  .ai-image-carousel__mobile-item-{{ ai_gen_id }} {
    width: 150px;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
  }

  .ai-image-carousel__mobile-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-image-carousel__mobile-placeholder-{{ ai_gen_id }} {
    width: 150px;
    aspect-ratio: 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-image-carousel__mobile-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-image-carousel__controls-{{ ai_gen_id }} {
    display: none;
    justify-content: center;
    gap: 10px;
    margin-top: 20px;
  }

  .ai-image-carousel__control-{{ ai_gen_id }} {
    background-color: {{ block.settings.control_color }};
    border: none;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: {{ block.settings.control_icon_color }};
    transition: background-color 0.3s ease;
  }

  .ai-image-carousel__control-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.control_hover_color }};
  }

  .ai-image-carousel__control-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-image-carousel__control-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-image-carousel__dots-{{ ai_gen_id }} {
    display: none;
    justify-content: center;
    gap: 8px;
    margin-top: 15px;
  }

  .ai-image-carousel__dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: {{ block.settings.control_color }};
    opacity: 0.3;
    cursor: pointer;transition: opacity 0.3s ease;
  }

  .ai-image-carousel__dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  @media screen and (max-width: 768px) {
    .ai-image-carousel__grid-{{ ai_gen_id }} {
      display: none;
    }

    .ai-image-carousel__mobile-container-{{ ai_gen_id }} {
      display: block;
    }

    .ai-image-carousel__controls-{{ ai_gen_id }} {
      display: flex;}

    .ai-image-carousel__dots-{{ ai_gen_id }} {
      display: flex;
    }

    .ai-image-carousel__heading-{{ ai_gen_id }} {
      margin-bottom: 20px;
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }
  }
{% endstyle %}<image-carousel-{{ ai_gen_id }}
  class="ai-image-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank %}
    <h2 class="ai-image-carousel__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
  {% endif %}

  <div class="ai-image-carousel__container-{{ ai_gen_id }}">
    <div class="ai-image-carousel__grid-{{ ai_gen_id }}">
      {% for i in (1..9) %}
        {% assign image_key = 'image_' | append: i %}
        {% assign image = block.settings[image_key] %}
        
        <div class="ai-image-carousel__item-{{ ai_gen_id }}">
          {% if image %}
            <img
              src="{{ image | image_url }}"
              alt="{{ image.alt | escape }}"
              class="ai-image-carousel__image-{{ ai_gen_id }}"
              loading="lazy"
              width="{{ image.width }}"
              height="{{ image.height }}"
            >
          {% else %}
            <div class="ai-image-carousel__placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}<div class="ai-image-carousel__empty-state-{{ ai_gen_id }}">
                Add image {{ i }}
              </div>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>

  <div class="ai-image-carousel__mobile-container-{{ ai_gen_id }}">
    <div class="ai-image-carousel__mobile-track-{{ ai_gen_id }}">
      <div class="ai-image-carousel__mobile-slides-{{ ai_gen_id }}" data-carousel-slides>
        {% assign images_with_content = '' %}
        {% for i in (1..9) %}
          {% assign image_key = 'image_' | append: i %}
          {% assign image = block.settings[image_key] %}
          {% if image %}
            {% assign images_with_content = images_with_content | append: i | append: ',' %}
          {% endif %}
        {% endfor %}
        {% assign images_array = images_with_content | split: ',' %}
        {% assign total_images = images_array.size | minus: 1 %}
        
        {% assign slide_count = total_images | divided_by: 2.0 | ceil %}
        
        {% for slide_index in (0..slide_count) %}
          {% assign start_index = slide_index | times: 2 %}
          {% assign end_index = start_index | plus: 1 %}
          {% if start_index < total_images %}<div class="ai-image-carousel__mobile-slide-{{ ai_gen_id }}">
              {% for item_index in (start_index..end_index) %}
                {% if item_index < total_images %}
                  {% assign image_number = images_array[item_index] %}
                  {% assign image_key = 'image_' | append: image_number %}
                  {% assign image = block.settings[image_key] %}
                
                  <div class="ai-image-carousel__mobile-item-{{ ai_gen_id }}"><img
                      src="{{ image | image_url: width: 150 }}"
                      alt="{{ image.alt | escape }}"
                      class="ai-image-carousel__mobile-image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="150"
                    >
                  </div>
                {% else %}
                  <div class="ai-image-carousel__mobile-item-{{ ai_gen_id }}">
                    <div class="ai-image-carousel__mobile-placeholder-{{ ai_gen_id }}">
                      {{ 'image' | placeholder_svg_tag }}
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="ai-image-carousel__controls-{{ ai_gen_id }}">
      <button
        class="ai-image-carousel__control-{{ ai_gen_id }}"
        data-carousel-prev
        aria-label="Previous slide"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="15,18 9,12 15,6"></polyline>
        </svg>
      </button>
      <button
        class="ai-image-carousel__control-{{ ai_gen_id }}"
        data-carousel-next
        aria-label="Next slide"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9,18 15,12 9,6"></polyline>
        </svg>
      </button>
    </div>

    <div class="ai-image-carousel__dots-{{ ai_gen_id }}" data-carousel-dots></div>
  </div>
</image-carousel-{{ ai_gen_id }}><script>
  (function() {
    class ImageCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.totalSlides = 0;
      }

      connectedCallback() {
        this.slidesContainer = this.querySelector('[data-carousel-slides]');
        this.prevButton = this.querySelector('[data-carousel-prev]');
        this.nextButton = this.querySelector('[data-carousel-next]');
        this.dotsContainer = this.querySelector('[data-carousel-dots]');
        this.slides = this.slidesContainer ? this.slidesContainer.querySelectorAll('.ai-image-carousel__mobile-slide-{{ ai_gen_id }}') : [];

        if (this.slides.length === 0) return;

        this.totalSlides = this.slides.length;
        this.setupCarousel();
        this.setupEventListeners();
        this.updateCarousel();
      }

      setupCarousel() {
        this.createDots();
      }

      createDots() {
        if (!this.dotsContainer) return;
        
        this.dotsContainer.innerHTML = '';
        for (let i = 0; i < this.totalSlides; i++) {
          const dot = document.createElement('button');
          dot.className = 'ai-image-carousel__dot-{{ ai_gen_id }}';
          dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
          dot.addEventListener('click', () => this.goToSlide(i));
          this.dotsContainer.appendChild(dot);
        }
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.prev());
        }
        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.next());
        }

        let startX = 0;
        let isDragging = false;

        this.slidesContainer.addEventListener('touchstart', (e) => {
          startX = e.touches[0].clientX;
          isDragging = true;
        });

        this.slidesContainer.addEventListener('touchmove', (e) => {
          if (!isDragging) return;
          e.preventDefault();
        });

        this.slidesContainer.addEventListener('touchend', (e) => {
          if (!isDragging) return;
          isDragging = false;
          
          const endX = e.changedTouches[0].clientX;
          const diff = startX - endX;
          
          if (Math.abs(diff) > 50) {
            if (diff > 0) {
              this.next();
            } else {
              this.prev();
            }
          }
        });
      }

      prev() {
        if (this.currentSlide > 0) {
          this.currentSlide--;
          this.updateCarousel();
        }
      }

      next() {
        if (this.currentSlide < this.totalSlides - 1) {
          this.currentSlide++;
          this.updateCarousel();
        }
      }

      goToSlide(index) {
        this.currentSlide = index;
        this.updateCarousel();
      }

      updateCarousel() {
        const translateX = -(this.currentSlide * 100);
        this.slidesContainer.style.transform = `translateX(${translateX}%)`;
        this.updateButtons();
        this.updateDots();
      }

      updateButtons() {
        if (this.prevButton) {
          this.prevButton.disabled = this.currentSlide === 0;
        }
        if (this.nextButton) {
          this.nextButton.disabled = this.currentSlide >= this.totalSlides - 1;
        }
      }

      updateDots() {
        if (!this.dotsContainer) return;
        
        const dots = this.dotsContainer.querySelectorAll('.ai-image-carousel__dot-{{ ai_gen_id }}');
        dots.forEach((dot, index) => {
          dot.classList.toggle('active', index === this.currentSlide);
        });
      }
    }

    customElements.define('image-carousel-{{ ai_gen_id }}', ImageCarousel{{ ai_gen_id }});
  })();
</script>

