{% doc %}
  @prompt
    Awarded by row with 4 images with 2 images on the mobile view which slides so only 2 images. seen at a time, can we make it 5 images on desk top
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-awarded-by-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    display: block;
  }

  .ai-awarded-by-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-awarded-by-heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-awarded-by-logos-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: {{ block.settings.logo_spacing }}px;
    align-items: center;
  }

  .ai-awarded-by-logo-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px;
  }

  .ai-awarded-by-logo-item-{{ ai_gen_id }} img {
    max-width: 100%;
    height: auto;
    max-height: {{ block.settings.logo_max_height }}px;
    object-fit: contain;
    filter: grayscale({{ block.settings.grayscale_amount }}%);
    opacity: {{ block.settings.logo_opacity }};
    transition: all 0.3s ease;
  }

  .ai-awarded-by-logo-item-{{ ai_gen_id }} img:hover {
    filter: grayscale(0%);
    opacity: 1;
  }

  .ai-awarded-by-logo-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.logo_max_height }}px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
  }

  .ai-awarded-by-logo-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-awarded-by-carousel-{{ ai_gen_id }} {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .ai-awarded-by-logos-{{ ai_gen_id }} {
      display: none;
    }

    .ai-awarded-by-carousel-{{ ai_gen_id }} {
      display: block;
      position: relative;
      overflow: hidden;
    }

    .ai-awarded-by-carousel-track-{{ ai_gen_id }} {
      display: flex;
      transition: transform 0.3s ease;
    }

    .ai-awarded-by-carousel-slide-{{ ai_gen_id }} {
      min-width: 50%;
      flex-shrink: 0;
      padding: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .ai-awarded-by-carousel-slide-{{ ai_gen_id }} img {
      max-width: 100%;
      height: auto;
      max-height: {{ block.settings.logo_max_height }}px;
      object-fit: contain;
      filter: grayscale({{ block.settings.grayscale_amount }}%);
      opacity: {{ block.settings.logo_opacity }};
    }

    .ai-awarded-by-nav-{{ ai_gen_id }} {
      display: flex;
      justify-content: center;
      gap: 8px;
      margin-top: 20px;
    }

    .ai-awarded-by-dot-{{ ai_gen_id }} {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: {{ block.settings.dot_color }};
      opacity: 0.3;
      border: none;
      padding: 0;
      cursor: pointer;
      transition: opacity 0.3s ease;
    }

    .ai-awarded-by-dot-{{ ai_gen_id }}.active {
      opacity: 1;
    }
  }
{% endstyle %}

<awarded-by-{{ ai_gen_id }} class="ai-awarded-by-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-awarded-by-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-awarded-by-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-awarded-by-logos-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign logo_key = 'logo_' | append: i
          assign logo = block.settings[logo_key]
        %}
        <div class="ai-awarded-by-logo-item-{{ ai_gen_id }}">
          {% if logo %}
            <img
              src="{{ logo | image_url: width: 400 }}"
              alt="{{ logo.alt | escape }}"
              loading="lazy"
              width="{{ logo.width }}"
              height="{{ logo.height }}"
            >
          {% else %}
            <div class="ai-awarded-by-logo-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    <div class="ai-awarded-by-carousel-{{ ai_gen_id }}">
      <div class="ai-awarded-by-carousel-track-{{ ai_gen_id }}">
        {% for i in (1..5) %}
          {% liquid
            assign logo_key = 'logo_' | append: i
            assign logo = block.settings[logo_key]
          %}
          <div class="ai-awarded-by-carousel-slide-{{ ai_gen_id }}">
            {% if logo %}
              <img
                src="{{ logo | image_url: width: 300 }}"
                alt="{{ logo.alt | escape }}"
                loading="lazy"
                width="{{ logo.width }}"
                height="{{ logo.height }}"
              >
            {% else %}
              <div class="ai-awarded-by-logo-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
      <div class="ai-awarded-by-nav-{{ ai_gen_id }}"></div>
    </div>
  </div>
</awarded-by-{{ ai_gen_id }}>

<script>
  (function() {
    class AwardedBy{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.totalSlides = 5;
        this.slidesPerView = 2;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-awarded-by-carousel-track-{{ ai_gen_id }}');
        this.nav = this.querySelector('.ai-awarded-by-nav-{{ ai_gen_id }}');
        
        if (!this.track || !this.nav) return;

        this.totalPages = Math.ceil(this.totalSlides / this.slidesPerView);
        this.createDots();
        this.setupSwipe();
        this.updateCarousel();
      }

      createDots() {
        for (let i = 0; i < this.totalPages; i++) {
          const dot = document.createElement('button');
          dot.classList.add('ai-awarded-by-dot-{{ ai_gen_id }}');
          dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
          if (i === 0) dot.classList.add('active');
          dot.addEventListener('click', () => this.goToPage(i));
          this.nav.appendChild(dot);
        }
      }

      goToPage(pageIndex) {
        this.currentIndex = pageIndex;
        this.updateCarousel();
      }

      updateCarousel() {
        const offset = -(this.currentIndex * 100);
        this.track.style.transform = `translateX(${offset}%)`;
        
        const dots = this.nav.querySelectorAll('.ai-awarded-by-dot-{{ ai_gen_id }}');
        dots.forEach((dot, index) => {
          if (index === this.currentIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      setupSwipe() {
        let startX = 0;
        let currentX = 0;
        let isDragging = false;

        this.track.addEventListener('touchstart', (e) => {
          startX = e.touches[0].clientX;
          isDragging = true;
        });

        this.track.addEventListener('touchmove', (e) => {
          if (!isDragging) return;
          currentX = e.touches[0].clientX;
        });

        this.track.addEventListener('touchend', () => {
          if (!isDragging) return;
          isDragging = false;

          const diff = startX - currentX;
          if (Math.abs(diff) > 50) {
            if (diff > 0 && this.currentIndex < this.totalPages - 1) {
              this.currentIndex++;
            } else if (diff < 0 && this.currentIndex > 0) {
              this.currentIndex--;
            }
            this.updateCarousel();
          }
        });
      }
    }

    customElements.define('awarded-by-{{ ai_gen_id }}', AwardedBy{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Awarded by",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Awarded by"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Heading spacing",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "Logos"
    },
    {
      "type": "image_picker",
      "id": "logo_1",
      "label": "Logo 1"
    },
    {
      "type": "image_picker",
      "id": "logo_2",
      "label": "Logo 2"
    },
    {
      "type": "image_picker",
      "id": "logo_3",
      "label": "Logo 3"
    },
    {
      "type": "image_picker",
      "id": "logo_4",
      "label": "Logo 4"
    },
    {
      "type": "image_picker",
      "id": "logo_5",
      "label": "Logo 5"
    },
    {
      "type": "range",
      "id": "logo_max_height",
      "label": "Logo max height",
      "min": 40,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "logo_spacing",
      "label": "Logo spacing",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "grayscale_amount",
      "label": "Grayscale",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "logo_opacity",
      "label": "Opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.5
    },
    {
      "type": "header",
      "content": "Mobile carousel"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Navigation dot color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section padding",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Awarded by"
    }
  ]
}
{% endschema %}
