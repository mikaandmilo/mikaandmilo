{% doc %}
  @prompt
    marquee section, same speed on desktop and mobile, speed on mobile to be 25, faster slide speed for mobile

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-marquee-container-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px 0;
  }

  .ai-marquee-track-{{ ai_gen_id }} {
    display: flex;
    width: max-content;
    animation: ai-marquee-scroll-{{ ai_gen_id }} {{ block.settings.speed_desktop }}s linear infinite;
  }

  .ai-marquee-item-{{ ai_gen_id }} {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    white-space: nowrap;
    padding: 0 {{ block.settings.item_spacing }}px;
  }

  .ai-marquee-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.font_size }}px;
    color: {{ block.settings.text_color }};
    font-weight: {{ block.settings.font_weight }};
  }

  @keyframes ai-marquee-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-marquee-track-{{ ai_gen_id }} {
      animation-duration: 25s;
    }

    .ai-marquee-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-marquee-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-marquee-track-{{ ai_gen_id }}">
    {% for i in (1..2) %}
      {% if block.settings.text_1 != blank %}
        <div class="ai-marquee-item-{{ ai_gen_id }}">
          <span class="ai-marquee-text-{{ ai_gen_id }}">{{ block.settings.text_1 }}</span>
        </div>
      {% endif %}{% if block.settings.text_2 != blank %}
        <div class="ai-marquee-item-{{ ai_gen_id }}">
          <span class="ai-marquee-text-{{ ai_gen_id }}">{{ block.settings.text_2 }}</span>
        </div>
      {% endif %}
      {% if block.settings.text_3 != blank %}
        <div class="ai-marquee-item-{{ ai_gen_id }}">
          <span class="ai-marquee-text-{{ ai_gen_id }}">{{ block.settings.text_3 }}</span>
        </div>
      {% endif %}
      {% if block.settings.text_4 != blank %}
        <div class="ai-marquee-item-{{ ai_gen_id }}">
          <span class="ai-marquee-text-{{ ai_gen_id }}">{{ block.settings.text_4 }}</span>
        </div>
      {% endif %}
      {% if block.settings.text_5 != blank %}
        <div class="ai-marquee-item-{{ ai_gen_id }}">
          <span class="ai-marquee-text-{{ ai_gen_id }}">{{ block.settings.text_5 }}</span>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Marquee",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "text_1",
      "label": "Text 1",
      "default": "Free shipping on orders over $50"
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "Text 2",
      "default": "30-day return policy"
    },
    {
      "type": "text",
      "id": "text_3",
      "label": "Text 3",
      "default": "Secure checkout"
    },
    {
      "type": "text",
      "id": "text_4",
      "label": "Text 4",
      "default": "24/7 customer support"
    },
    {
      "type": "text",
      "id": "text_5",
      "label": "Text 5",
      "default": "Fast delivery"
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "speed_desktop",
      "label": "Speed on desktop",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "s",
      "default": 40
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Font size on mobile",
      "min": 10,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical padding",
      "min": 5,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "item_spacing",
      "label": "Item spacing",
      "min": 10,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Marquee"
    }
  ]
}
{% endschema %}