{% doc %}
  @prompt
    Awarded by row with 4 images with 2 images on the mobile view which slides so only 2 images. seen at a time, can we make it 5 images on desk top
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-awarded-by-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-awarded-by-container-{{ ai_gen_id }} {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-awarded-by-heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-awarded-by-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: {{ block.settings.logo_spacing }}px;
    align-items: center;
  }

  .ai-awarded-by-logo-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.logo_padding }}px;
  }

  .ai-awarded-by-logo-{{ ai_gen_id }} img {
    max-width: 100%;
    height: auto;
    max-height: {{ block.settings.logo_max_height }}px;
    object-fit: contain;
    filter: grayscale({{ block.settings.grayscale_amount }}%);
    opacity: {{ block.settings.logo_opacity }};
    transition: all 0.3s ease;
  }

  .ai-awarded-by-logo-{{ ai_gen_id }} img:hover {
    filter: grayscale(0%);
    opacity: 1;
  }

  .ai-awarded-by-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100px;
  }

  .ai-awarded-by-placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    opacity: 0.3;
  }

  @media screen and (max-width: 749px) {
    .ai-awarded-by-grid-{{ ai_gen_id }} {
      display: none;
    }

    .ai-awarded-by-carousel-{{ ai_gen_id }} {
      display: block;
      position: relative;
      overflow: hidden;
    }

    .ai-awarded-by-carousel-track-{{ ai_gen_id }} {
      display: flex;
      transition: transform 0.3s ease;
      gap: {{ block.settings.logo_spacing }}px;
    }

    .ai-awarded-by-carousel-slide-{{ ai_gen_id }} {
      flex: 0 0 calc(50% - {{ block.settings.logo_spacing | divided_by: 2 }}px);
      min-width: calc(50% - {{ block.settings.logo_spacing | divided_by: 2 }}px);
    }

    .ai-awarded-by-carousel-dots-{{ ai_gen_id }} {
      display: flex;
      justify-content: center;
      gap: 8px;
      margin-top: 20px;
    }

    .ai-awarded-by-carousel-dot-{{ ai_gen_id }} {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: {{ block.settings.dot_color }};
      opacity: 0.3;
      border: none;
      padding: 0;
      cursor: pointer;
      transition: opacity 0.3s ease;
    }

    .ai-awarded-by-carousel-dot-{{ ai_gen_id }}.active {
      opacity: 1;
    }
  }

  @media screen and (min-width: 750px) {
    .ai-awarded-by-carousel-{{ ai_gen_id }} {
      display: none;
    }
  }
{% endstyle %}

<awarded-by-{{ ai_gen_id }}
  class="ai-awarded-by-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-awarded-by-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-awarded-by-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-awarded-by-grid-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign logo_key = 'logo_' | append: i
          assign logo = block.settings[logo_key]
        %}
        <div class="ai-awarded-by-logo-{{ ai_gen_id }}">
          {% if logo != blank %}
            <img
              src="{{ logo | image_url: width: 400 }}"
              alt="{{ logo.alt | escape }}"
              loading="lazy"
              width="{{ logo.width }}"
              height="{{ logo.height }}"
            >
          {% else %}
            <div class="ai-awarded-by-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    <div class="ai-awarded-by-carousel-{{ ai_gen_id }}">
      <div class="ai-awarded-by-carousel-track-{{ ai_gen_id }}">
        {% for i in (1..5) %}
          {% liquid
            assign logo_key = 'logo_' | append: i
            assign logo = block.settings[logo_key]
          %}
          <div class="ai-awarded-by-carousel-slide-{{ ai_gen_id }}">
            <div class="ai-awarded-by-logo-{{ ai_gen_id }}">
              {% if logo != blank %}
                <img
                  src="{{ logo | image_url: width: 400 }}"
                  alt="{{ logo.alt | escape }}"
                  loading="lazy"
                  width="{{ logo.width }}"
                  height="{{ logo.height }}"
                >
              {% else %}
                <div class="ai-awarded-by-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>

      <div class="ai-awarded-by-carousel-dots-{{ ai_gen_id }}">
        <button
          class="ai-awarded-by-carousel-dot-{{ ai_gen_id }} active"
          data-index="0"
          aria-label="Go to slide 1"
        ></button>
        <button
          class="ai-awarded-by-carousel-dot-{{ ai_gen_id }}"
          data-index="1"
          aria-label="Go to slide 2"
        ></button>
        <button
          class="ai-awarded-by-carousel-dot-{{ ai_gen_id }}"
          data-index="2"
          aria-label="Go to slide 3"
        ></button>
      </div>
    </div>
  </div>
</awarded-by-{{ ai_gen_id }}>

<script>
  (function() {
    class AwardedBy{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.totalSlides = 3;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-awarded-by-carousel-track-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-awarded-by-carousel-dot-{{ ai_gen_id }}');
        
        if (!this.track || !this.dots.length) return;

        this.setupEventListeners();
        this.setupTouchEvents();
      }

      setupEventListeners() {
        this.dots.forEach((dot) => {
          dot.addEventListener('click', (e) => {
            const index = parseInt(e.target.dataset.index);
            this.goToSlide(index);
          });
        });
      }

      setupTouchEvents() {
        let startX = 0;
        let currentX = 0;
        let isDragging = false;

        this.track.addEventListener('touchstart', (e) => {
          startX = e.touches[0].clientX;
          isDragging = true;
        });

        this.track.addEventListener('touchmove', (e) => {
          if (!isDragging) return;
          currentX = e.touches[0].clientX;
        });

        this.track.addEventListener('touchend', () => {
          if (!isDragging) return;
          isDragging = false;

          const diff = startX - currentX;
          
          if (Math.abs(diff) > 50) {
            if (diff > 0 && this.currentIndex < this.totalSlides - 1) {
              this.goToSlide(this.currentIndex + 1);
            } else if (diff < 0 && this.currentIndex > 0) {
              this.goToSlide(this.currentIndex - 1);
            }
          }
        });
      }

      goToSlide(index) {
        this.currentIndex = index;
        const offset = -index * 100;
        this.track.style.transform = `translateX(${offset}%)`;

        this.dots.forEach((dot, i) => {
          if (i === index) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }
    }

    customElements.define('awarded-by-{{ ai_gen_id }}', AwardedBy{{ ai_gen_id }});
  })();
</script>

