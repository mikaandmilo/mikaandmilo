{% doc %}
  @prompt
    Create a two-row static logo display section for a premium children's knitwear brand. Top row has a small label "Awarded by" on the left, followed by 4 award logos displayed horizontally with generous spacing between them. Bottom row has a small label "Featured in" on the left, followed by 4 press/media logos displayed horizontally with generous spacing between them. All 8 logo images should be customizable via theme settings. Clean, minimal, editorial design. No carousel or scrolling — logos are static and evenly spaced. Ample padding between the two rows.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-logo-display-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-logo-display-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-logo-display-row-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.logo_spacing }}px;
    margin-bottom: {{ block.settings.row_spacing }}px;
  }

  .ai-logo-display-row-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-logo-display-label-{{ ai_gen_id }} {
    font-family: {{ block.settings.label_font.family }}, {{ block.settings.label_font.fallback_families }};
    font-weight: {{ block.settings.label_font.weight }};
    font-size: {{ block.settings.label_font_size }}px;
    color: {{ block.settings.label_color }};
    text-transform: {{ block.settings.label_text_transform }};
    letter-spacing: {{ block.settings.label_letter_spacing }}px;
    white-space: nowrap;
    flex-shrink: 0;
    min-width: {{ block.settings.label_min_width }}px;
  }

  .ai-logo-display-logos-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.logo_spacing }}px;
    flex-wrap: wrap;
    flex-grow: 1;
  }

  .ai-logo-display-logo-wrapper-{{ ai_gen_id }} {
    flex-shrink: 0;
  }

  .ai-logo-display-logo-{{ ai_gen_id }} {
    max-width: {{ block.settings.logo_max_width }}px;
    height: auto;
    display: block;
    opacity: {{ block.settings.logo_opacity }};
    transition: opacity 0.3s ease;
  }

  .ai-logo-display-logo-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-logo-display-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.logo_max_width }}px;
    height: 60px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
  }

  .ai-logo-display-placeholder-{{ ai_gen_id }} svg {
    width: 40px;
    height: 40px;
    opacity: 0.3;
  }

  @media screen and (max-width: 749px) {
    .ai-logo-display-row-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: flex-start;
      gap: {{ block.settings.mobile_row_gap }}px;
    }

    .ai-logo-display-logos-{{ ai_gen_id }} {
      width: 100%;
      justify-content: space-between;
      gap: {{ block.settings.mobile_logo_spacing }}px;
    }

    .ai-logo-display-logo-{{ ai_gen_id }} {
      max-width: {{ block.settings.mobile_logo_max_width }}px;
    }

    .ai-logo-display-placeholder-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_logo_max_width }}px;
      height: 40px;
    }

    .ai-logo-display-label-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_label_font_size }}px;
    }
  }
{% endstyle %}

<div class="ai-logo-display-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-logo-display-container-{{ ai_gen_id }}">
    <div class="ai-logo-display-row-{{ ai_gen_id }}">
      <div class="ai-logo-display-label-{{ ai_gen_id }}">
        {{ block.settings.awards_label }}
      </div>
      <div class="ai-logo-display-logos-{{ ai_gen_id }}">
        {% for i in (1..4) %}
          {% assign award_logo_key = 'award_logo_' | append: i %}
          {% assign award_logo = block.settings[award_logo_key] %}
          
          <div class="ai-logo-display-logo-wrapper-{{ ai_gen_id }}">
            {% if award_logo %}
              <img
                src="{{ award_logo | image_url: width: 400 }}"
                alt="{{ award_logo.alt | escape }}"
                loading="lazy"
                width="{{ award_logo.width }}"
                height="{{ award_logo.height }}"
                class="ai-logo-display-logo-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-logo-display-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="ai-logo-display-row-{{ ai_gen_id }}">
      <div class="ai-logo-display-label-{{ ai_gen_id }}">
        {{ block.settings.press_label }}
      </div>
      <div class="ai-logo-display-logos-{{ ai_gen_id }}">
        {% for i in (1..4) %}
          {% assign press_logo_key = 'press_logo_' | append: i %}
          {% assign press_logo = block.settings[press_logo_key] %}
          
          <div class="ai-logo-display-logo-wrapper-{{ ai_gen_id }}">
            {% if press_logo %}
              <img
                src="{{ press_logo | image_url: width: 400 }}"
                alt="{{ press_logo.alt | escape }}"
                loading="lazy"
                width="{{ press_logo.width }}"
                height="{{ press_logo.height }}"
                class="ai-logo-display-logo-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-logo-display-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

