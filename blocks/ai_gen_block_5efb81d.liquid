{% doc %}
  @prompt
    marquee section, same speed on desktop and mobile, speed on mobile to be 25, faster slide speed for mobile

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-marquee-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px 0;
    border-top: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-bottom: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
  }

  .ai-marquee-content-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    white-space: nowrap;
    animation: ai-marquee-scroll-{{ ai_gen_id }} {{ block.settings.speed }}s linear infinite;
  }

  .ai-marquee-item-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    margin-right: {{ block.settings.item_spacing }}px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    text-transform: {% if block.settings.text_transform == 'uppercase' %}uppercase{% elsif block.settings.text_transform == 'lowercase' %}lowercase{% else %}none{% endif %};
  }

  .ai-marquee-separator-{{ ai_gen_id }} {
    display: inline-block;
    margin: 0 {{ block.settings.separator_spacing }}px;
    color: {{ block.settings.separator_color }};
    font-size: {{ block.settings.separator_size }}px;
  }

  {% if block.settings.direction == 'right' %}
    .ai-marquee-content-{{ ai_gen_id }} {
      animation-direction: reverse;
    }
  {% endif %}

  {% if block.settings.pause_on_hover %}
    .ai-marquee-{{ ai_gen_id }}:hover .ai-marquee-content-{{ ai_gen_id }} {
      animation-play-state: paused;
    }
  {% endif %}

  @keyframes ai-marquee-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-100%);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-marquee-content-{{ ai_gen_id }} {
      animation-duration: {{ block.settings.mobile_speed }}s;
    }.ai-marquee-item-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
    }
    .ai-marquee-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_vertical | times: 0.7 }}px 0;
    }
  }
{% endstyle %}<div class="ai-marquee-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-marquee-content-{{ ai_gen_id }}">
    {% for i in (1..2) %}
      {% if block.settings.text_1 != blank %}
        <span class="ai-marquee-item-{{ ai_gen_id }}">{{ block.settings.text_1 }}</span>
        {% if block.settings.separator != blank %}
          <span class="ai-marquee-separator-{{ ai_gen_id }}">{{ block.settings.separator }}</span>
        {% endif %}
      {% endif %}
      
      {% if block.settings.text_2 != blank %}
        <span class="ai-marquee-item-{{ ai_gen_id }}">{{ block.settings.text_2 }}</span>
        {% if block.settings.separator != blank %}
          <span class="ai-marquee-separator-{{ ai_gen_id }}">{{ block.settings.separator }}</span>
        {% endif %}
      {% endif %}
      
      {% if block.settings.text_3 != blank %}
        <span class="ai-marquee-item-{{ ai_gen_id }}">{{ block.settings.text_3 }}</span>
        {% if block.settings.separator != blank %}
          <span class="ai-marquee-separator-{{ ai_gen_id }}">{{ block.settings.separator }}</span>
        {% endif %}
      {% endif %}
      
      {% if block.settings.text_4 != blank %}
        <span class="ai-marquee-item-{{ ai_gen_id }}">{{ block.settings.text_4 }}</span>
        {% if block.settings.separator != blank %}
          <span class="ai-marquee-separator-{{ ai_gen_id }}">{{ block.settings.separator }}</span>
        {% endif %}
      {% endif %}
      
      {% if block.settings.text_5 != blank %}
        <span class="ai-marquee-item-{{ ai_gen_id }}">{{ block.settings.text_5 }}</span>
        {% if block.settings.separator != blank and forloop.last == false %}
          <span class="ai-marquee-separator-{{ ai_gen_id }}">{{ block.settings.separator }}</span>
        {% endif %}
      {% endif %}
    {% endfor %}
  </div>
</div>

