{% doc %}
  @prompt
    center headline and subheadline, under that 3 videos per row with carousel, 4 videos equal, and slider on phone, 1440 withd, on desktop just 3 videos on screen with carousel for 4th video, one video per slider on mobile, videos size 9x16, 4 videos per scroll on desktop, autoplay every video and without bar, 4x3 video size, 3x4 video dimension

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-carousel-{{ ai_gen_id }} {
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};}

  .ai-video-carousel__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-video-carousel__headline-{{ ai_gen_id }} {
    color: {{ block.settings.headline_color }};
    font-size: {{ block.settings.headline_size }}px;
    margin: 0 0 16px 0;
  }

  .ai-video-carousel__subheadline-{{ ai_gen_id }} {
    color: {{ block.settings.subheadline_color }};
    font-size: {{ block.settings.subheadline_size }}px;
    margin: 0;
  }

  .ai-video-carousel__container-{{ ai_gen_id }} {
    position: relative;
    max-width: 1440px;
    margin: 0 auto;
  }

  .ai-video-carousel__desktop-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-video-carousel__desktop-track-{{ ai_gen_id }} {
    display: flex;
    gap: 24px;
    transition: transform 0.3s ease;
  }

  .ai-video-carousel__desktop-slide-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - 48px) / 3);
  }

  .ai-video-carousel__video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 3/4;
    border-radius: {{ block.settings.video_border_radius }}px;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-video-carousel__video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-video-carousel__video-{{ ai_gen_id }}::-webkit-media-controls {
    display: none !important;
  }

  .ai-video-carousel__video-{{ ai_gen_id }}::-webkit-media-controls-panel {
    display: none !important;
  }

  .ai-video-carousel__video-{{ ai_gen_id }}::-webkit-media-controls-play-button {
    display: none !important;
  }

  .ai-video-carousel__video-{{ ai_gen_id }}::-webkit-media-controls-start-playback-button {
    display: none !important;
  }

  .ai-video-carousel__video-{{ ai_gen_id }}::-webkit-media-controls-timeline {
    display: none !important;
  }

  .ai-video-carousel__video-{{ ai_gen_id }}::-webkit-media-controls-current-time-display {
    display: none !important;
  }

  .ai-video-carousel__video-{{ ai_gen_id }}::-webkit-media-controls-time-remaining-display {
    display: none !important;
  }

  .ai-video-carousel__video-{{ ai_gen_id }}::-webkit-media-controls-mute-button {
    display: none !important;
  }

  .ai-video-carousel__video-{{ ai_gen_id }}::-webkit-media-controls-volume-slider {
    display: none !important;
  }

  .ai-video-carousel__video-{{ ai_gen_id }}::-webkit-media-controls-fullscreen-button {
    display: none !important;
  }

  .ai-video-carousel__video-{{ ai_gen_id }}::-webkit-media-controls-toggle-closed-captions-button {
    display: none !important;
  }

  .ai-video-carousel__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
    color: #666;
    font-size: 14px;
  }

  .ai-video-carousel__placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    opacity: 0.5;
  }

  .ai-video-carousel__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    color: #999;
    font-size: 12px;
    text-align: center;
    pointer-events: none;
  }

  .ai-video-carousel__desktop-controls-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    margin-top: 24px;
  }

  .ai-video-carousel__nav-button-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: 50%;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-video-carousel__nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-video-carousel__nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-video-carousel__dots-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .ai-video-carousel__dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-video-carousel__dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
  }

  .ai-video-carousel__mobile-slider-{{ ai_gen_id }} {
    display: none;overflow: hidden;
    position: relative;
  }

  .ai-video-carousel__mobile-track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.3s ease;
  }

  .ai-video-carousel__mobile-slide-{{ ai_gen_id }} {
    flex: 0 0 100%;
    padding: 0 20px;box-sizing: border-box;
  }

  .ai-video-carousel__mobile-controls-{{ ai_gen_id }} {
    display: none;
    justify-content: center;
    align-items: center;
    gap: 16px;
    margin-top: 24px;
  }

  @media screen and (max-width: 768px) {
    .ai-video-carousel__desktop-wrapper-{{ ai_gen_id }},
    .ai-video-carousel__desktop-controls-{{ ai_gen_id }} {
      display: none;
    }

    .ai-video-carousel__mobile-slider-{{ ai_gen_id }} {
      display: block;
    }

    .ai-video-carousel__mobile-controls-{{ ai_gen_id }} {
      display: flex;
    }

    .ai-video-carousel__headline-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.headline_size }}px * 0.8);
    }

    .ai-video-carousel__subheadline-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheadline_size }}px * 0.9);
    }
  }
{% endstyle %}<video-carousel-{{ ai_gen_id }}
  class="ai-video-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-video-carousel__header-{{ ai_gen_id }}">
    {% if block.settings.headline != blank %}
      <h2 class="ai-video-carousel__headline-{{ ai_gen_id }}">{{ block.settings.headline }}</h2>
    {% endif %}
    {% if block.settings.subheadline != blank %}
      <p class="ai-video-carousel__subheadline-{{ ai_gen_id }}">{{ block.settings.subheadline }}</p>
    {% endif %}
  </div>

  <div class="ai-video-carousel__container-{{ ai_gen_id }}">
    <div class="ai-video-carousel__desktop-wrapper-{{ ai_gen_id }}">
      <div class="ai-video-carousel__desktop-track-{{ ai_gen_id }}">
        {% for i in (1..8) %}
          {% assign video_key = 'video_' | append: i %}
          {% assign video = block.settings[video_key] %}
          
          <div class="ai-video-carousel__desktop-slide-{{ ai_gen_id }}">
            <div class="ai-video-carousel__video-wrapper-{{ ai_gen_id }}">
              {% if video != blank %}
                <video
                  class="ai-video-carousel__video-{{ ai_gen_id }}"
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                >
                  <source src="{{ video }}" type="video/mp4">
                  Your browser does not support the video tag.
                </video>
              {% else %}
                <div class="ai-video-carousel__placeholder-{{ ai_gen_id }}">
                  {{'image' | placeholder_svg_tag }}{% if i == 1 %}
                    <div class="ai-video-carousel__empty-state-{{ ai_gen_id }}">
                      Add videos to get started
                    </div>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div></div>

    <div class="ai-video-carousel__desktop-controls-{{ ai_gen_id }}">
      <button
        class="ai-video-carousel__nav-button-{{ ai_gen_id }} ai-video-carousel__desktop-prev-{{ ai_gen_id }}"
        aria-label="Previous videos"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="15,18 9,12 15,6"></polyline>
        </svg>
      </button>

      <div class="ai-video-carousel__dots-{{ ai_gen_id }}">
        {% assign total_videos = 0 %}
        {% for i in (1..8) %}
          {% assign video_key = 'video_' | append: i %}
          {% assign video = block.settings[video_key] %}
          {% if video != blank %}
            {% assign total_videos = total_videos | plus: 1 %}
          {% endif %}
        {% endfor %}
        
        {% if total_videos > 3 %}
          {% assign total_pages = total_videos | minus: 3 | divided_by: 4 | plus: 1 %}
          {% for i in (1..total_pages) %}
            <button
              class="ai-video-carousel__dot-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
              data-page="{{ forloop.index0 }}"
              aria-label="Go to page {{ forloop.index }}"
            ></button>
          {% endfor %}
        {% endif %}
      </div>

      <button
        class="ai-video-carousel__nav-button-{{ ai_gen_id }} ai-video-carousel__desktop-next-{{ ai_gen_id }}"
        aria-label="Next videos"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9,18 15,12 9,6"></polyline>
        </svg>
      </button>
    </div>

    <div class="ai-video-carousel__mobile-slider-{{ ai_gen_id }}">
      <div class="ai-video-carousel__mobile-track-{{ ai_gen_id }}">
        {% for i in (1..8) %}
          {% assign video_key = 'video_' | append: i %}
          {% assign video = block.settings[video_key] %}
          {% if video != blank %}
            <div class="ai-video-carousel__mobile-slide-{{ ai_gen_id }}">
              <div class="ai-video-carousel__video-wrapper-{{ ai_gen_id }}">
                <video
                  class="ai-video-carousel__video-{{ ai_gen_id }}"
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                >
                  <source src="{{ video }}" type="video/mp4">
                  Your browser does not support the video tag.
                </video>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="ai-video-carousel__mobile-controls-{{ ai_gen_id }}">
      <button
        class="ai-video-carousel__nav-button-{{ ai_gen_id }} ai-video-carousel__mobile-prev-{{ ai_gen_id }}"
        aria-label="Previous video"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="15,18 9,12 15,6"></polyline>
        </svg>
      </button>

      <div class="ai-video-carousel__mobile-dots-{{ ai_gen_id }}">
        {% for i in (1..8) %}
          {% assign video_key = 'video_' | append: i %}
          {% assign video = block.settings[video_key] %}
          {% if video != blank %}
            <button
              class="ai-video-carousel__dot-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
              data-mobile-slide="{{ forloop.index0 }}"
              aria-label="Go to video {{ forloop.index }}"
            ></button>
          {% endif %}
        {% endfor %}
      </div>

      <button
        class="ai-video-carousel__nav-button-{{ ai_gen_id }} ai-video-carousel__mobile-next-{{ ai_gen_id }}"
        aria-label="Next video"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9,18 15,12 9,6"></polyline>
        </svg>
      </button>
    </div>
  </div>
</video-carousel-{{ ai_gen_id }}><script>
  (function() {
    class VideoCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.desktopCurrentPage = 0;
        this.mobileCurrentSlide = 0;
        this.totalVideos = 0;
        this.totalDesktopPages = 0;}

      connectedCallback() {
        this.desktopTrack = this.querySelector('.ai-video-carousel__desktop-track-{{ ai_gen_id }}');
        this.mobileTrack = this.querySelector('.ai-video-carousel__mobile-track-{{ ai_gen_id }}');
        this.mobileSlides = this.querySelectorAll('.ai-video-carousel__mobile-slide-{{ ai_gen_id }}');
        this.desktopDots = this.querySelectorAll('[data-page]');
        this.mobileDots = this.querySelectorAll('[data-mobile-slide]');
        this.desktopPrevButton = this.querySelector('.ai-video-carousel__desktop-prev-{{ ai_gen_id }}');
        this.desktopNextButton = this.querySelector('.ai-video-carousel__desktop-next-{{ ai_gen_id }}');
        this.mobilePrevButton = this.querySelector('.ai-video-carousel__mobile-prev-{{ ai_gen_id }}');
        this.mobileNextButton = this.querySelector('.ai-video-carousel__mobile-next-{{ ai_gen_id }}');

        this.totalVideos = this.mobileSlides.length;
        this.totalDesktopPages = Math.max(0, Math.ceil((this.totalVideos - 3) / 4));
        this.setupEventListeners();
        this.updateDesktopCarousel();
        this.updateMobileCarousel();this.handleVideoAutoplay();
      }

      handleVideoAutoplay() {
        const videos = this.querySelectorAll('.ai-video-carousel__video-{{ ai_gen_id }}');
        videos.forEach(video => {
          video.addEventListener('loadedmetadata', () => {
            video.play().catch(() => {
              console.log('Autoplay prevented by browser');
            });
          });
        });
      }

      setupEventListeners() {
        if (this.desktopPrevButton) {
          this.desktopPrevButton.addEventListener('click', () => this.previousDesktopPage());
        }
        if (this.desktopNextButton) {
          this.desktopNextButton.addEventListener('click', () => this.nextDesktopPage());
        }
        if (this.mobilePrevButton) {
          this.mobilePrevButton.addEventListener('click', () => this.previousMobileSlide());
        }
        if (this.mobileNextButton) {
          this.mobileNextButton.addEventListener('click', () => this.nextMobileSlide());
        }

        this.desktopDots.forEach((dot, index) => {
          dot.addEventListener('click', () => this.goToDesktopPage(index));
        });

        this.mobileDots.forEach((dot, index) => {
          dot.addEventListener('click', () => this.goToMobileSlide(index));
        });

        let startX = 0;
        let currentX = 0;
        let isDragging = false;

        if (this.mobileTrack) {
          this.mobileTrack.addEventListener('touchstart', (e) => {
            startX = e.touches[0].clientX;
            isDragging = true;
          });

          this.mobileTrack.addEventListener('touchmove', (e) => {
            if (!isDragging) return;
            currentX = e.touches[0].clientX;
          });

          this.mobileTrack.addEventListener('touchend', () => {
            if (!isDragging) return;
            const diffX = startX - currentX;
            
            if (Math.abs(diffX) > 50) {
              if (diffX > 0) {
                this.nextMobileSlide();
              } else {
                this.previousMobileSlide();
              }
            }
            isDragging = false;
          });
        }
      }

      updateDesktopCarousel() {
        if (!this.desktopTrack) return;
        
        const slideWidth = (100 + 24) / 3;
        const translateX = -this.desktopCurrentPage * 4 * (slideWidth /3);
        this.desktopTrack.style.transform = `translateX(${translateX}%)`;

        this.desktopDots.forEach((dot, index) => {
          dot.classList.toggle('active', index === this.desktopCurrentPage);
        });

        if (this.desktopPrevButton) {
          this.desktopPrevButton.disabled = this.desktopCurrentPage === 0;
        }
        if (this.desktopNextButton) {
          this.desktopNextButton.disabled = this.desktopCurrentPage >= this.totalDesktopPages;
        }
      }

      updateMobileCarousel() {
        if (!this.mobileTrack) return;
        
        const translateX = -this.mobileCurrentSlide * 100;
        this.mobileTrack.style.transform = `translateX(${translateX}%)`;

        this.mobileDots.forEach((dot, index) => {
          dot.classList.toggle('active', index === this.mobileCurrentSlide);
        });

        if (this.mobilePrevButton) {
          this.mobilePrevButton.disabled = this.mobileCurrentSlide === 0;
        }
        if (this.mobileNextButton) {
          this.mobileNextButton.disabled = this.mobileCurrentSlide === this.totalVideos - 1;
        }
      }

      nextDesktopPage() {
        if (this.desktopCurrentPage < this.totalDesktopPages) {
          this.desktopCurrentPage++;
          this.updateDesktopCarousel();
        }
      }

      previousDesktopPage() {
        if (this.desktopCurrentPage > 0) {
          this.desktopCurrentPage--;
          this.updateDesktopCarousel();
        }
      }

      goToDesktopPage(index) {
        this.desktopCurrentPage = index;
        this.updateDesktopCarousel();
      }

      nextMobileSlide() {
        if (this.mobileCurrentSlide < this.totalVideos - 1) {
          this.mobileCurrentSlide++;
          this.updateMobileCarousel();
        }
      }

      previousMobileSlide() {
        if (this.mobileCurrentSlide > 0) {
          this.mobileCurrentSlide--;
          this.updateMobileCarousel();
        }
      }

      goToMobileSlide(index) {
        this.mobileCurrentSlide = index;
        this.updateMobileCarousel();
      }
    }

    customElements.define('video-carousel-{{ ai_gen_id }}', VideoCarousel{{ ai_gen_id }});
  })();
</script>

