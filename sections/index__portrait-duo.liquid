{% comment %}
** Portrait Duo - two portrait images side by side with captions below
{% endcomment %}

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: {{ section.settings.padding_horizontal }}px;
    padding-right: {{ section.settings.padding_horizontal }}px;
  }

  #shopify-section-{{ section.id }} .portrait-duo {
    display: flex;
    gap: {{ section.settings.gap }}px;
    align-items: flex-start;
  }

  #shopify-section-{{ section.id }} .portrait-duo__item {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  /* Image container — holds the aspect ratio */
  #shopify-section-{{ section.id }} .portrait-duo__image-wrap {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4/5;
    display: block;
  }

  #shopify-section-{{ section.id }} .portrait-duo__image-wrap img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  #shopify-section-{{ section.id }} .portrait-duo__item:hover .portrait-duo__image-wrap img {
    transform: scale(1.03);
  }

  /* Full-image link overlay */
  #shopify-section-{{ section.id }} .portrait-duo__image-link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* Caption sits below the image in normal flow */
  #shopify-section-{{ section.id }} .portrait-duo__caption {
    padding-top: 14px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .portrait-duo__title {
    font-size: 0.85em;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0 0 6px;
    font-weight: 500;
    color: inherit;
  }

  #shopify-section-{{ section.id }} .portrait-duo__cta {
    display: inline-block;
    font-size: 0.78em;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: inherit;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
    text-decoration: none;
    opacity: 0.65;
    transition: opacity 0.2s ease;
  }

  #shopify-section-{{ section.id }} .portrait-duo__cta:hover {
    opacity: 1;
  }

  @media only screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .portrait-duo {
      flex-direction: column;
      align-items: stretch;
    }
    #shopify-section-{{ section.id }} .portrait-duo__item {
      width: 100%;
    }
    #shopify-section-{{ section.id }} .portrait-duo__image-wrap {
      aspect-ratio: 3/4;
    }
  }
{% endstyle %}

<div class="portrait-duo">
  {% for block in section.blocks %}
    {% assign image = block.settings.image %}
    <div class="portrait-duo__item" {{ block.shopify_attributes }}>

      <div class="portrait-duo__image-wrap">
        {% if image != blank %}
          <img
            src="{{ image | img_url: '1200x' }}"
            srcset="{{ image | img_url: '600x' }} 600w, {{ image | img_url: '900x' }} 900w, {{ image | img_url: '1200x' }} 1200w, {{ image | img_url: '1600x' }} 1600w"
            sizes="(max-width: 768px) 100vw, 50vw"
            alt="{{ image.alt | escape }}"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
          />
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}

        {% if block.settings.link != blank %}
          <a href="{{ block.settings.link }}" class="portrait-duo__image-link" aria-label="{{ block.settings.title }}"></a>
        {% endif %}
      </div>

      {% if block.settings.title != blank or block.settings.cta != blank %}
        <div class="portrait-duo__caption">
          {% if block.settings.title != blank %}
            <p class="portrait-duo__title">{{ block.settings.title }}</p>
          {% endif %}
          {% if block.settings.cta != blank and block.settings.link != blank %}
            <a href="{{ block.settings.link }}" class="portrait-duo__cta">{{ block.settings.cta }}</a>
          {% elsif block.settings.cta != blank %}
            <span class="portrait-duo__cta">{{ block.settings.cta }}</span>
          {% endif %}
        </div>
      {% endif %}

    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Portrait Duo",
  "class": "portrait-duo-section index-section",
  "max_blocks": 2,
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Portrait orientation recommended (e.g. 800 x 1000px)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Collection title",
          "default": "Collection Name"
        },
        {
          "type": "text",
          "id": "cta",
          "label": "CTA text",
          "default": "Shop Now"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between images",
      "min": 0,
      "max": 40,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 80,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 80,
      "default": 24,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Portrait Duo",
      "category": "Image",
      "blocks": [
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["*"]
  }
}
{% endschema %}
