{% style %}
  .trust-bar-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    padding: 40px 0;
    border-top: 1px solid #e8e0d8;
    border-bottom: 1px solid #e8e0d8;
  }

  .trust-bar-{{ section.id }} .trust-bar__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }

  .trust-bar-{{ section.id }} .trust-bar__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
  }

  .trust-bar-{{ section.id }} .trust-bar__icon {
    width: 32px;
    height: 32px;
    color: {{ section.settings.icon_color }};
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .trust-bar-{{ section.id }} .trust-bar__icon .icon {
    width: 32px !important;
    height: 32px !important;
    min-width: 32px !important;
    min-height: 32px !important;
  }

  .trust-bar-{{ section.id }} .trust-bar__icon svg {
    display: block;
    width: 32px !important;
    height: 32px !important;
  }

  .trust-bar-{{ section.id }} .trust-bar__heading {
    font-family: {{ settings.banner_heading__font.family }}, sans-serif;
    font-size: 15px;
    font-weight: 700;
    color: {{ section.settings.text_color }};
    margin: 0;
    line-height: 1.3;
  }

  .trust-bar-{{ section.id }} .trust-bar__text {
    font-family: {{ settings.banner_heading__font.family }}, sans-serif;
    font-size: 15px;
    color: {{ section.settings.text_color }};
    opacity: 0.75;
    margin: 0;
    line-height: 1.5;
  }

  @media only screen and (max-width: 768px) {
    .trust-bar-{{ section.id }} .trust-bar__inner {
      grid-template-columns: repeat(2, 1fr);
      padding: 0 20px;
      gap: 28px;
    }
  }

  @media only screen and (max-width: 480px) {
    .trust-bar-{{ section.id }} .trust-bar__inner {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .trust-bar-{{ section.id }} {
      padding: 28px 0;
    }
  }
{% endstyle %}

<div class="trust-bar-{{ section.id }}">
  <div class="trust-bar__inner">
    {% for block in section.blocks %}
      <div class="trust-bar__item" {{ block.shopify_attributes }}>
        <div class="trust-bar__icon">
          {% assign icon_name = block.settings.icon | downcase %}
          {% assign a_to_l = 'a,b,c,d,e,f,g,h,i,j,k,l' | split: ',' %}
          {% assign icon_first_letter = icon_name | slice: 0 %}
          {% if a_to_l contains icon_first_letter %}
            {% render 'icon_outline_a-l', name: icon_name %}
          {% else %}
            {% render 'icon_outline_m-z', name: icon_name %}
          {% endif %}
        </div>
        {% if block.settings.heading != blank %}
          <p class="trust-bar__heading">{{ block.settings.heading }}</p>
        {% endif %}
        {% if block.settings.text != blank %}
          <p class="trust-bar__text">{{ block.settings.text }}</p>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Trust bar",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background colour",
      "default": "#fbf7f6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#3a3a3a"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon colour",
      "default": "#3a3a3a"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "truck",
          "options": [
            { "value": "truck", "label": "Delivery" },
            { "value": "recycle", "label": "Returns" },
            { "value": "leaf", "label": "Organic / Leaf" },
            { "value": "star", "label": "Award / Star" },
            { "value": "gift", "label": "Gift" },
            { "value": "heart", "label": "Heart" },
            { "value": "globe", "label": "Globe" },
            { "value": "checkmark", "label": "Checkmark" }
          ]
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Free Delivery"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Supporting text",
          "default": "On all orders over $165"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "icon": "truck",
            "heading": "Free Delivery Over $165",
            "text": "US duties included"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "recycle",
            "heading": "28-Day Returns",
            "text": "Free & easy returns on all orders"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "leaf",
            "heading": "Organic & Sustainable",
            "text": "95% organic cotton, GOTS certified supplier"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "star",
            "heading": "Award-Winning",
            "text": "Six-time Junior Design Award winner"
          }
        }
      ]
    }
  ]
}
{% endschema %}
