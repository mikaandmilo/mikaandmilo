    "index_image_with_text_6bFqMQ": {
      "type": "index__image-with-text",
      "blocks": {
        "text_Hmj8Dx": {
          "type": "text",
          "settings": {
            "title": "The Story Behind MIKA & MILO",
            "heading_size": "regular",
            "text": "<p>MIKA & MILO was born from the belief that children’s knitwear should be soft enough for every day, durable enough to hand down, and beautiful enough to keep.</p><p>Drawing on over 100 years of Scottish textile heritage, we blend 95% organic cotton with 5% cashmere to create knitwear made for real childhood — from playtime to washing day and everything in between.</p><p>Awarded by six Junior Design Awards and featured in Vogue and Vanity Fair, each piece is thoughtfully made to be worn now and treasured for years to come.</p><p>Made for today. Kept for tomorrow.</p>",
            "alignment": "left",
            "vertical_position": "center",
            "button_label": "",
            "link": "",
            "button_style": "button--primary",
            "background": "#ffffff",
            "text_color": "rgba(0,0,0,0)",
            "mobile_title": "",
            "mobile_heading_size": "same_as_desktop",
            "mobile_text": "",
            "mobile_alignment": "same_as_desktop"
          }
        },
        "image_wHp3mx": {
