    "index_faq_RhQBjF": {
      "type": "index__faq",
      "blocks": {
        "heading_qBHQQh": {
          "type": "heading",
          "settings": {
            "title": "Your Questions, Answered"
          }
        },
        "content_h6icVp": {
          "type": "content",
          "settings": {
            "title": "What makes MIKA & MILO different?",
            "answer": "<p>We create thoughtfully made knitwear that balances softness, practicality, and lasting quality. </p><p>Made from organic cotton and cashmere, our pieces are gentle on sensitive skin, machine-washable, and designed to be worn, loved, and handed down.</p>"
          }
        },
        "content_UaKEA7": {
          "type": "content",
          "settings": {
            "title": "Is it suitable for sensitive skin? ",
            "answer": "<p> Yes — MIKA & MILO knitwear is made from 95% organic cotton and 5% cashmere, chosen specifically for its softness against delicate skin. Our blend is naturally non-itch and free from harsh chemicals, making it comfortable for all-day wear —even for children with sensitive skin or eczema. </p><p>If your child has ever refused to wear a jumper because it \"feels scratchy\", this is the knitwear that changes that.</p>"
          }
        },
        "content_pW8wFg": {
          "type": "content",
          "settings": {
            "title": "What are MIKA & MILO clothes made from?",
            "answer": "<p>We use a luxuriously soft blend of<strong>95% organic cotton and 5% cashmere</strong>, chosen for sensitive skin, durability, and everyday comfort. </p><p>Our cashmere is sourced from Inner Mongolia, renowned for its exceptionally soft fibres.</p>"
          }
        },
        "content_EXdcbD": {
          "type": "content",
          "settings": {
            "title": "Will they last long enough to pass on?",
            "answer": "<p>Absolutely. Each piece is thoughtfully made to be<strong>worn, washed, and handed down</strong>, while maintaining its shape, softness, and colour.</p>"
          }
        },
        "content_cj4eDK": {
          "type": "content",
          "settings": {
            "title": "Can I machine-wash MIKA & MILO knitwear?",
            "answer": "<p>Yes — our knitwear is designed to be<strong>machine-washable on a cool, delicate cycle</strong>, while staying soft and keeping its shape.</p>"
          }
        },
        "content_P3Bh8h": {
          "type": "content",
          "settings": {
            "title": "What is your returns policy if the size doesn't fit?",
            "answer": "<p>We offer<strong>28-day returns</strong>on unused items with original tags attached. </p><p>For more details, please visit our .<a href=\"https://mika-milo.com/pages/delivery-returns\" target=\"_blank\" title=\"https://mika-milo.com/pages/delivery-returns\"><strong>Delivery & Returns </strong></a> and  <a href=\"https://cdn.shopify.com/s/files/1/0332/2786/6248/files/2025_Size_GUIDE.pdf?v=1759449946\" target=\"_blank\" title=\"https://cdn.shopify.com/s/files/1/0332/2786/6248/files/2025_Size_GUIDE.pdf?v=1759449946\"><strong>Size Guide</strong></a><strong>  </strong>pages.</p><p>For any other questions, please email<a href=\"mailto:aiko@mika-milo.com\"><strong>aiko@mika-milo.com</strong></a>— we’re always happy to help.</p>"
          }
        },
        "content_rVpAdX": {
          "type": "content",
          "settings": {
            "title": "Where do you ship?",
            "answer": "<p>We ship <strong>worldwide</strong>. </p><p>Orders are dispatched from our <strong>Hong Kong warehouse</strong>, and for U.S. customers, <strong>duties and taxes are included i</strong>n the checkout price.</p>"
          }
        },
