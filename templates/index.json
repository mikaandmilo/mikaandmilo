    "index_testimonial_iDrH9N": {
      "type": "index__testimonial",
      "blocks": {
        "image_iG3rYC": {
          "type": "image",
          "settings": {
            "quote": "<p>\"Absolutely love the vibrant colour palette, soft to the touch cotton/cashmere mix and the fact that my favourite jumpers are now machine washable!\"</p>",
            "image": "shopify://shop_images/JDA_2023_Logo_Gold.jpg",
            "text": "<p>Bonita Turner</p><p>Editor of Junior</p>",
            "info_text": "rgba(0,0,0,0)",
            "info_background": "rgba(0,0,0,0)"
          }
        },
        "image_8neEHG": {
          "type": "image",
          "settings": {
            "quote": "<p>\"A lovely, fresh, more child-focused approach to cashmere. And a beautiful selection of jumpers.\"</p>",
            "image": "shopify://shop_images/JDA_2022_Logos-Gold_861c6d6c-7a6c-4824-aa20-2cd7280f0fd5.png",
            "text": "<p>Charlotte Kewley</p><p>Children’s Stylist and content creator @thelittlestylist</p><p></p>",
            "info_text": "rgba(0,0,0,0)",
            "info_background": "rgba(0,0,0,0)"
          }
        },
        "image_zJHezY": {
          "type": "image",
          "settings": {
            "quote": "<p>\"Beautiful quality and timeless designs – a smart move making the move to a cashmere cotton blend.\"</p>",
            "image": "shopify://shop_images/JDA21_Logo_Gold_0ee80ddf-39f9-4d1d-a6ee-1ec0264552a5.jpg",
            "text": "<p>George Reddings</p><p>Children’s fashion designer and founder of slow fashion brand, Colour Story @george_ggredd_</p><p></p>",
            "info_text": "rgba(0,0,0,0)",
            "info_background": "rgba(0,0,0,0)"
          }
        },
        "image_VT7iCp": {
          "type": "image",
          "settings": {
            "quote": "<p>\"Beautiful pieces. So lovely to hear a brand's backstory too.\" </p>",
            "image": "shopify://shop_images/JDA_2024_Logos_Silver.jpg",
            "text": "<p><strong>Abi Campbell</strong></p><p>Children’s fashion photographer and brand consultant</p><p> @abicampbellphotography</p>",
            "info_text": "rgba(0,0,0,0)",
            "info_background": "rgba(0,0,0,0)"
          }
        },
        "image_UU4tde": {
          "type": "image",
          "settings": {
            "quote": "<p>\"These are the most beautiful, luxurious, sustainable pieces. They have a wonderful family design history and are perfect for future hand-me-downs.\"</p>",
            "image": "shopify://shop_images/JDA2021_Silver_edcf01cd-eff3-42d0-bdbc-ee80d372247f.png",
            "text": "<p><strong>Emma McMenemy</strong>, </p><p>Content Creator</p><p>@emma_mcmenemy</p>",
            "info_text": "rgba(0,0,0,0)",
            "info_background": "rgba(0,0,0,0)"
          }
        },
        "image_BeWFYX": {
          "type": "image",
          "settings": {
            "quote": "<p>\"An absolutely beautiful way to present children’s cashmere. I love the soft colour palette and fashionable designs, while the details such as the thunder bolt and ruffles make this such a darling brand.\"</p>",
            "image": "shopify://shop_images/JDA_2023_Logo_Gold_e401601c-f611-4189-bf7e-d64ddbd2fd8c.jpg",
            "text": "<p><strong>Yvadney Davis</strong></p><p>Children’s Stylist</p>",
            "info_text": "rgba(0,0,0,0)",
            "info_background": "rgba(0,0,0,0)"
          }
        }
      },
      "block_order": [
