    "index_testimonial_iDrH9N": {
      "type": "index__testimonial",
      "blocks": {
        "image_iG3rYC": {
          "type": "image",
          "settings": {
            "quote": "<p>\"Absolutely love the vibrant colour palette, soft to the touch cotton/cashmere mix and the fact that my favourite jumpers are now machine washable!\"</p>",
            "image": "shopify://shop_images/JDA_2023_Logo_Gold.jpg",
            "text": "<p>Bonita Turner</p><p>Editor of Junior</p>",
            "info_text": "rgba(0,0,0,0)",
            "info_background": "rgba(0,0,0,0)"
          }
        },
        "image_8neEHG": {
          "type": "image",
          "settings": {
            "quote": "<p>\"A lovely, fresh, more child-focused approach to cashmere. And a beautiful selection of jumpers.\"</p>",
            "image": "shopify://shop_images/JDA_2022_Logos-Gold_861c6d6c-7a6c-4824-aa20-2cd7280f0fd5.png",
            "text": "<p>Charlotte Kewley</p><p>Children’s Stylist and content creator @thelittlestylist</p><p></p>",
            "info_text": "rgba(0,0,0,0)",
            "info_background": "rgba(0,0,0,0)"
          }
        },
        "image_zJHezY": {
          "type": "image",
          "settings": {
            "quote": "<p>\"Beautiful quality and timeless designs – a smart move making the move to a cashmere cotton blend.\"</p>",
