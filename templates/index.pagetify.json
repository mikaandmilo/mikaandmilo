    "index_faq_RhQBjF": {
      "type": "index__faq",
      "blocks": {
        "heading_qBHQQh": {
          "type": "heading",
          "settings": {
            "title": "FAQ"
          }
        },
        "content_pW8wFg": {
          "type": "content",
          "settings": {
            "title": "What materials do you use?",
            "answer": "<p>We use organic cotton and cashmere blends, chosen for their softness, safety, and durability.</p>"
          }
        },
        "content_4NjBj8": {
          "type": "content",
          "settings": {
            "title": "Are the clothes machine washable?",
            "answer": "<p>Yes — all our knitwear is designed to handle regular washing while staying soft and keeping its shape.</p>"
          }
        },
        "content_EXdcbD": {
          "type": "content",
          "settings": {
            "title": "Do the products last through hand-me-downs?",
            "answer": "<p>Absolutely. Our pieces are made with heirloom quality so they can be worn, washed, and passed down.</p>"
          }
        },
        "content_rVpAdX": {
          "type": "content",
          "settings": {
            "title": "Where do you ship?",
            "answer": "<p>We ship worldwide, straight from our online store to your door.</p>"
          }
        },
        "content_h6icVp": {
          "type": "content",
          "settings": {
            "title": "What makes MIKA & MILO different?",
            "answer": "<p>Unlike fast fashion, our knitwear combines organic eco-friendly fabrics and dyes with multi award-winning design. Each piece is built to last: to be loved now and treasured later. </p>"
          }
        },
        "content_P3Bh8h": {
          "type": "content",
          "settings": {
            "title": "What if the size doesn’t fit?",
            "answer": "<p>You can return or exchange your item following our hassle-free refund and exchange policy.</p><p>Please have a look at our detailed size guide for help when making a purchase for any questions, simply email us at: aiko@mika-milo.com</p>"
          }
        },
        "image_bGPRbN": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/2.png"
          }
        }
      },
