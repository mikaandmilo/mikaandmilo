    "index_image_with_text_6bFqMQ": {
      "type": "index__image-with-text",
      "blocks": {
        "text_Hmj8Dx": {
          "type": "text",
          "settings": {
            "title": "",
            "heading_size": "regular",
            "text": "<p><strong>The Perfect Hand-Me-Down: Luxury That Lasts</strong></p><p><strong>MIKA & MILO</strong> began with a simple belief: children’s knitwear should be as durable as it is comfortable. Inspired by Inner Mongolian cashmere herders and our founder’s own cashmere hand-me-downs, we make heirloom-quality knits designed to survive playground tumbles, washing-machine cycles, and—most importantly—multiple hand-me-downs.</p><p>Every stitch is GOTS-certified organic, every seam ethically crafted in Inner Mongolia, and every design tested by real kids because our favorite compliment is: <em>‘It gives me super powers.\"</em></p><p>Winner of 6 Junior Design Awards, including Best Children's Eco brand twice, <strong>MIKA & MILO</strong> makes cloud-soft knits your little ones will love <em>now</em>, and their own children will treasure <em>later</em>. After all, surely our kids and the planet they will inherit deserve nothing but the best!</p>",
            "alignment": "left",
            "vertical_position": "center",
            "button_label": "",
            "link": "",
            "button_style": "button--primary",
            "background": "rgba(0,0,0,0)",
            "text_color": "rgba(0,0,0,0)",
            "mobile_title": "",
            "mobile_heading_size": "same_as_desktop",
            "mobile_text": "",
            "mobile_alignment": "same_as_desktop"
          }
        },
        "image_wHp3mx": {
          "type": "image",
          "disabled": true,
          "settings": {
            "image": "shopify://shop_images/Milo_Lightning_Jumper_67b85200-2f87-4c1e-b001-84ce54ad712c.jpg",
            "mobile_image": "shopify://shop_images/Milo_Lightning_Jumper_67b85200-2f87-4c1e-b001-84ce54ad712c.jpg",
            "image_link": ""
          }
        }
      },
