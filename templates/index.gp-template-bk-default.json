    "index_image_with_text_6bFqMQ": {
      "block_order": [
        "text_Hmj8Dx",
        "image_wHp3mx"
      ],
      "blocks": {
        "image_wHp3mx": {
          "disabled": true,
          "settings": {
            "image": "shopify://shop_images/Milo_Lightning_Jumper_67b85200-2f87-4c1e-b001-84ce54ad712c.jpg",
            "image_link": "",
            "mobile_image": "shopify://shop_images/Milo_Lightning_Jumper_67b85200-2f87-4c1e-b001-84ce54ad712c.jpg"
          },
          "type": "image"
        },
        "text_Hmj8Dx": {
          "settings": {
            "alignment": "left",
            "background": "rgba(0,0,0,0)",
            "button_label": "",
            "button_style": "button--primary",
            "heading_size": "regular",
            "link": "",
            "mobile_alignment": "same_as_desktop",
            "mobile_heading_size": "same_as_desktop",
            "mobile_text": "",
            "mobile_title": "",
            "text": "<p><strong>MIKA & MILO began with a simple belief: that the perfect hand-me-down combines lasting organic luxury with unstoppable play.</strong></p><p>Inspired by Inner Mongolian cashmere herders and our founder’s own cashmere hand-me-downs, we make heirloom-quality knits designed to survive playground tumbles, washing-machine cycles, and—most importantly—multiple hand-me-downs.</p><p><strong>As a 6-time Junior Design Award winner, </strong>every stitch is ethically crafted in Inner Mongolia, and every design tested by real kids because our favorite compliment is: <strong>‘It gives me super powers!\"</strong></p><p>We make cloud-soft organic knits your little ones will love now, and save as treasured hand-me-downs later. After all, surely our kids, and the planet they will inherit, deserve nothing but the best.</p>",
            "text_color": "rgba(0,0,0,0)",
            "title": "",
            "vertical_position": "center"
          },
          "type": "text"
        }
      },
