        "16306825309648acac-3": {
          "type": "content",
          "settings": {
            "title": "Do you ship internationally?",
            "answer": "<p>Yes! We now ship worldwide. Shipping rates will vary on your country and preferred method. Please keep in mind your package may take a bit longer than expected due to customs.</p>"
